        <mxCell id="inner-lane" value="1. Inner goal-delivery loop&#xa;Policy lifecycle: submitted -&gt; planned -&gt; implementing -&gt; review -&gt; reviewed -&gt; merging -&gt; completed" style="swimlane;html=1;rounded=1;startSize=58;horizontal=1;fillColor=none;strokeColor=#C7D1DB;dashed=1;dashPattern=4 5;fontStyle=1;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="155" width="970" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="outer-lane" value="2. Outer production-learning loop&#xa;Merged main is built once, attested, progressively deployed, observed, and routed to rollback or one deduplicated fix-forward goal." style="swimlane;html=1;rounded=1;startSize=58;horizontal=1;fillColor=none;strokeColor=#C7D1DB;dashed=1;dashPattern=4 5;fontStyle=1;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="505" width="1490" height="285" as="geometry"/>
        </mxCell>
