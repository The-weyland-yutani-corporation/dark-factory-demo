{
  "name": "dark-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:web",
    "build:web": "npm run build --workspace=@dark-factory/web",
    "bootstrap": "node scripts/bootstrap.mjs",
    "clean": "tsc -b --clean && node scripts/clean.mjs",
    "dev:api": "npm run dev --workspace=@dark-factory/api",
    "dev:web": "npm run dev --workspace=@dark-factory/web",
    "dev:worker": "npm run dev --workspace=@dark-factory/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "scan:container": "node scripts/container-policy.mjs",
    "scan:dependencies": "npm audit --omit=dev --audit-level=high",
    "scan:iac": "node scripts/iac-policy.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "start:api": "npm run start --workspace=@dark-factory/api",
    "start:worker": "npm run start --workspace=@dark-factory/worker",
    "test": "vitest run --coverage",
    "test:accessibility": "vitest run tests/web-accessibility.test.tsx",
    "test:api-contract": "vitest run tests/api-contract.test.ts",
    "test:delivery": "node --test scripts/delivery/self-test.mjs",
    "test:demo": "node --test scripts/demo/self-test.mjs",
    "test:integration-policy": "vitest run tests/policy-engine.test.ts",
    "test:infrastructure": "node --test scripts/infrastructure/self-test.mjs",
    "test:operations": "node --test scripts/operations/self-test.mjs",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tests/tsconfig.json --pretty false",
    "verify": "node scripts/verify.mjs",
    "verify:agentic-sync": "node scripts/sync-agentic-workflows.mjs --check",
    "verify:agentic-credentials": "node scripts/validate-agentic-credentials.mjs",
    "verify:bicep": "node scripts/bicep-validate.mjs",
    "verify:evidence": "node scripts/evidence.mjs validate",
    "verify:workflows": "node scripts/workflow-lint.mjs",
    "reconcile:github": "node scripts/reconcile-github.mjs",
    "test:self-modification": "node --test scripts/self-modification/self-test.mjs",
    "demo": "tsc -b packages/contracts packages/policy-engine && node scripts/demo/run.mjs --assert-idempotent",
    "demo:offline": "npm run demo",
    "demo:list": "tsc -b packages/contracts packages/policy-engine && node scripts/demo/run.mjs --list",
    "config:validate": "node scripts/validate-config.mjs",
    "teardown:plan": "node scripts/teardown-plan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
